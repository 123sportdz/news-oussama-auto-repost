# Copy to .env and fill in your own values. NEVER commit .env.
# انسخ الملف إلى .env وعمّر القيم تاعك. ما تنشرش .env أبدا.

# Long-lived Page access token (Graph API publishing).
# Leave empty to use facebook-cli instead (each publish asks approval).
# Page tokens are PER PAGE — one token never covers two Pages. Prefer
# one line per Page (these exact page_ids are in config.yaml):
# Easiest way to set them: open the dashboard (.\setup.bat --dashboard)
# and paste each token in "🔑 توكنات الصفحات" — it validates and saves
# it here for you. Or fill the lines below by hand (see
# docs/get-page-tokens.md for how to get the tokens):
FB_PAGE_ACCESS_TOKEN_147624121772177=
FB_PAGE_ACCESS_TOKEN_107469321989814=
# FB_PAGE_ACCESS_TOKEN=  # optional shared fallback, used only when
# no per-page token above is set for that Page.

# Facebook App (only needed if you create your own app/token).
FB_APP_ID=
FB_APP_SECRET=

# Dashboard port (default 8080).
DASHBOARD_PORT=8080

# Telegram notifications (optional). Talk to @BotFather for the bot
# token, and to @userinfobot for your chat id. Easiest way to set
# them: the dashboard home page, card "🔔 تنبيهات Telegram".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard password (optional). Empty = the dashboard trusts
# localhost only, as before. Set a password before exposing the port
# (e.g. via a tunnel) — the dashboard can publish and manage tokens.
DASHBOARD_PASSWORD=
